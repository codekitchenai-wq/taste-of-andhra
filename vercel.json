{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "taste-of-andhra.vercel.app"
        }
      ],
      "destination": "https://www.directapp.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "taste-of-andhra.vercel.app"
        }
      ],
      "destination": "https://www.directapp.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
