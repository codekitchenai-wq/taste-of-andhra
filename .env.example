# Supabase (required)
# Find these in Supabase Dashboard → Project Settings → API
# Replace the placeholders below with your real Project URL and anon public key.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.paste-your-anon-key-here

# Razorpay (optional — leave empty to use demo payment UI)
# Dashboard → Settings → API Keys → Key Id (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=

# Razorpay SERVER secrets (Supabase Edge Functions — NOT VITE_)
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=...
#   supabase functions deploy razorpay-confirm
#   supabase functions deploy razorpay-webhook --no-verify-jwt
# Webhook URL:
#   https://<project-ref>.supabase.co/functions/v1/razorpay-webhook
# Staging without live keys:
#   supabase secrets set ALLOW_DEMO_PAYMENTS=true

# Architecture gates (default OFF = hold). See docs/ARCHITECTURE_GATES.md
# VITE_ENABLE_HOST_TENANT_RESOLUTION=false
# VITE_ENABLE_SCOPED_ORG_ADMIN_AUTH=false
# VITE_ENABLE_RAZORPAY_ROUTE=false
# VITE_ENABLE_META_EMBEDDED_SIGNUP=false
# VITE_ENABLE_AI=false

# Platform apex domain for tenant subdomains (optional)
# Chopsticks with slug `chopsticks` → https://chopsticks.thetasteofandhra.com
VITE_PLATFORM_ROOT_DOMAIN=thetasteofandhra.com

# UPI pay-later QR (optional; Admin → Settings overrides this)
# Test default in code is tasteofandhra@okaxis — replace with your real VPA later.
VITE_UPI_VPA=tasteofandhra@okaxis
VITE_UPI_PAYEE_NAME=The Taste of Andhra

# Google Maps (optional — address picker falls back to manual entry without it)
VITE_GOOGLE_MAPS_API_KEY=

# Google reviews (optional)
# Place ID for the Google Business Profile listing. Find it at
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Enables the "Review us on Google" prompt on delivered orders.
VITE_GOOGLE_PLACE_ID=

# Hosted reviews widget loader script (Trustindex, Elfsight, etc).
# When set, the homepage shows live Google reviews instead of the static
# testimonials. Trustindex example: https://cdn.trustindex.io/loader.js?abc123
VITE_GOOGLE_REVIEWS_WIDGET_SRC=
# Only needed for providers that render into their own container div,
# e.g. Elfsight: elfsight-app-xxxxxxxx
VITE_GOOGLE_REVIEWS_WIDGET_CLASS=

# Pidge third-party delivery — SERVER SIDE ONLY.
# These are NOT VITE_ variables. The API token can spend your Pidge wallet, so
# it must never reach the browser bundle. Set them as Supabase Edge Function
# secrets instead. Full walkthrough: docs/PIDGE_SETUP.md
#   supabase secrets set PIDGE_API_TOKEN=... PIDGE_WEBHOOK_TOKEN=... PIDGE_CHANNEL_NAME=taste-of-andhra
#   supabase functions deploy delivery-quote
#   supabase functions deploy pidge-dispatch
#   supabase functions deploy pidge-webhook
#
#   PIDGE_API_TOKEN        Channel token from Pidge → Settings → Channel Integration
#   PIDGE_WEBHOOK_TOKEN    Auth token you set on the same screen, used to verify callbacks
#   PIDGE_CHANNEL_NAME     Channel name registered with that token (default taste-of-andhra)
#   PIDGE_API_BASE_URL     Optional, defaults to https://api.pidge.in
#   PIDGE_QUOTE_PATH       Optional, override if your account uses a different quote route
#   PIDGE_CREATE_ORDER_PATH / PIDGE_CANCEL_ORDER_PATH   Optional overrides
#
# Webhook URL to paste in Pidge:
#   https://<project-ref>.supabase.co/functions/v1/pidge-webhook
#
# Leave PIDGE_API_TOKEN unset to run on the built-in rate card; checkout still
# works and simply quotes your own delivery charge.

# Communication module — SERVER SIDE ONLY (Supabase Edge Function secrets).
# These are NOT VITE_ variables. Provider credentials never ship in the browser.
#
# Platform provider defaults (org settings can override):
#   WHATSAPP_PROVIDER=meta_cloud|mock|gupshup
#   SMS_PROVIDER=mock|gupshup
#   PUBLIC_STOREFRONT_URL           Used in WhatsApp menu replies (…/menu)
#
# Local / CI without Meta:
#   supabase secrets set WHATSAPP_PROVIDER=mock PUBLIC_STOREFRONT_URL=http://localhost:5173
#   In Admin → WhatsApp: Phone Number ID = mock_phone, Access token = mock
#   Deploy sim: supabase functions deploy whatsapp-conversation-sim
#
# Production Meta Cloud:
#   supabase secrets set WHATSAPP_PROVIDER=meta_cloud SMS_PROVIDER=mock \
#     WHATSAPP_WEBHOOK_VERIFY_TOKEN=<shared-secret> \
#     PUBLIC_STOREFRONT_URL=https://your-domain.com
#   supabase functions deploy communication-dispatch
#   supabase functions deploy whatsapp-dispatch
#   supabase functions deploy whatsapp-connect
#   supabase functions deploy whatsapp-webhook --no-verify-jwt
#   supabase functions deploy whatsapp-embedded-signup
#   supabase functions deploy whatsapp-conversation-sim
#
# Meta Cloud API (when WHATSAPP_PROVIDER=meta_cloud):
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN   Platform fallback for Meta webhook GET verify
#   WHATSAPP_GRAPH_API_VERSION      Optional, defaults to v21.0
#   WHATSAPP_GRAPH_API_BASE         Optional Graph API base URL override
#   WHATSAPP_META_APP_ID            Required only for Embedded Signup
#   WHATSAPP_META_APP_SECRET        Required only for Embedded Signup
# Per-restaurant Meta access tokens are stored in organization_whatsapp_configs
# by the whatsapp-connect function (write-only / never SELECT from browser).
# Step-by-step Meta account setup: docs/WHATSAPP_META_SETUP.md
#
# Gupshup (Phase D — do not invent fields; verify current Gupshup docs first):
#   GUPSHUP_WHATSAPP_API_KEY=
#   GUPSHUP_SMS_API_KEY=
#
# Apply migrations:
#   supabase/migrations/20260808120000_whatsapp_multi_tenant.sql
#   supabase/migrations/20260809120000_communication_module.sql
#   supabase/migrations/20260809130000_menu_modifiers.sql
#   supabase/migrations/20260809140000_whatsapp_conversation_sessions.sql
# Local development: copy this file to .env.local and fill in your values.
# Vercel deployment: add the same variables in Project Settings → Environment Variables.
# Only variables prefixed with VITE_ are exposed to the browser.
